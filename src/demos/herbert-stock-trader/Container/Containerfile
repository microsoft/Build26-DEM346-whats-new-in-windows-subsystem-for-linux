FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99
ENV HOME=/root

# Install core desktop & VNC packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xfce4 \
    xfce4-terminal \
    thunar \
    x11vnc \
    novnc \
    websockify \
    dbus-x11 \
    xdotool \
    wmctrl \
    xterm \
    xdg-utils \
    # Python for ghost (GTK3+Cairo for transparent overlay)
    python3 \
    python3-gi \
    python3-gi-cairo \
    gir1.2-gtk-3.0 \
    # Compositor for RGBA transparency
    xcompmgr \
    # Impressive CLI tools
    btop \
    htop \
    cmatrix \
    # Utilities
    curl \
    wget \
    procps \
    net-tools \
    sudo \
    fonts-dejavu-core \
    fonts-liberation \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install additional fun terminal tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    hollywood \
    libaa-bin \
    toilet \
    figlet \
    python3-pip \
    && pip3 install --no-cache-dir websockets \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install cbonsai and pipes.sh from source
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    make \
    libncursesw5-dev \
    git \
    && git clone https://gitlab.com/jallbrit/cbonsai.git /tmp/cbonsai \
    && cd /tmp/cbonsai && make install \
    && curl -sL https://raw.githubusercontent.com/pipeseroni/pipes.sh/master/pipes.sh -o /usr/local/bin/pipes.sh \
    && chmod +x /usr/local/bin/pipes.sh \
    && apt-get remove -y gcc make libncursesw5-dev git \
    && apt-get autoremove -y \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/cbonsai

# Configure XFCE for auto-start (no login manager)
RUN mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml

# Set dark theme and panel config
RUN mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml && \
    echo '<?xml version="1.0" encoding="UTF-8"?>\n\
<channel name="xsettings" version="1.0">\n\
  <property name="Net" type="empty">\n\
    <property name="ThemeName" type="string" value="Adwaita-dark"/>\n\
    <property name="IconThemeName" type="string" value="Adwaita"/>\n\
  </property>\n\
  <property name="Gtk" type="empty">\n\
    <property name="CursorThemeName" type="string" value="Adwaita"/>\n\
  </property>\n\
</channel>' > /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml

# Set desktop wallpaper to solid dark color
RUN mkdir -p /root/.config/xfce4/xfconf/xfce-perchannel-xml && \
    echo '<?xml version="1.0" encoding="UTF-8"?>\n\
<channel name="xfce4-desktop" version="1.0">\n\
  <property name="backdrop" type="empty">\n\
    <property name="screen0" type="empty">\n\
      <property name="monitorscreen" type="empty">\n\
        <property name="workspace0" type="empty">\n\
          <property name="color-style" type="int" value="0"/>\n\
          <property name="image-style" type="int" value="0"/>\n\
          <property name="rgba1" type="array">\n\
            <value type="double" value="0.10980"/>\n\
            <value type="double" value="0.12157"/>\n\
            <value type="double" value="0.17647"/>\n\
            <value type="double" value="1.0"/>\n\
          </property>\n\
        </property>\n\
      </property>\n\
    </property>\n\
  </property>\n\
</channel>' > /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml

# Copy noVNC auto-connect index page
COPY index.html /usr/share/novnc/index.html

# Copy wallpaper
COPY wallpaper.png /usr/share/backgrounds/ghost-wallpaper.png

# Copy ghost application
COPY ghost/ /opt/ghost/

# Copy startup script
COPY start.sh /start.sh
RUN sed -i 's/\r$//' /start.sh && chmod +x /start.sh

# noVNC web port + WebSocket trade data port
EXPOSE 6080
EXPOSE 8765

CMD ["/start.sh"]
